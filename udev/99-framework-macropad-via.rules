# SPDX-License-Identifier: GPL-2.0-or-later
# Framework Laptop 16 RGB Macropad: hidraw access for VIA and the deck tooling.
#
# The rule grants the logged-in seat through uaccess and nothing wider. On the
# machine this was written on the ACL sometimes failed to come back after a
# re-enumeration, leaving the node root:root 0600; docs/FLASHING.md says how to
# add GROUP="input" yourself if you hit that, and what it costs.
#
# Install:
#   sudo cp 99-framework-macropad-via.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger

SUBSYSTEM=="hidraw", ATTRS{idVendor}=="32ac", ATTRS{idProduct}=="0013", TAG+="uaccess"
