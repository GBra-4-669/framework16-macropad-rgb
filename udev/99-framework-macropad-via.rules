# SPDX-License-Identifier: GPL-2.0-or-later
# Framework Laptop 16 RGB Macropad: hidraw access for VIA and the deck tooling.
#
# The udev uaccess ACL did not survive re-enumeration here, so the rule also
# grants the input group, which is what made the node readable. That group can read every input device, not only this
# module; docs/FLASHING.md says what the trade costs and how to drop the group
# if your machine keeps the ACL.
#
# Install:
#   sudo cp 99-framework-macropad-via.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
#   sudo usermod -aG input $USER     (then log in again)

SUBSYSTEM=="hidraw", ATTRS{idVendor}=="32ac", ATTRS{idProduct}=="0013", MODE="0660", GROUP="input", TAG+="uaccess"
